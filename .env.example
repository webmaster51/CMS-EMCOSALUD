# ─────────────────────────────────────────────────────────────
#  CMS EMCO SALUD — variables de entorno
#  Copia este archivo a `.env` y completa los valores.
#  NUNCA subas `.env` al repositorio.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
APP_URL=http://localhost:4321
PORT=4321
# Zona horaria para fechas mostradas / programación de contenidos
APP_TIMEZONE=America/Bogota
LOG_LEVEL=info

# Base de datos (PostgreSQL 16)
DATABASE_URL=postgres://cms:cms@localhost:5432/cms
# Tamaño máximo del pool de conexiones
DATABASE_POOL_MAX=10
# Driver: `pg` (PostgreSQL real, producción) o `pglite` (Postgres embebido para
# desarrollo sin Docker; persiste en .data/pglite; no usar en producción).
DB_DRIVER=pg

# Autenticación (Better Auth)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
SESSION_TTL_HOURS=8
REMEMBER_TTL_DAYS=30

# Storage
# Driver: `s3` (MinIO/S3, producción) o `fs` (disco local en .data/media, desarrollo sin Docker).
STORAGE_DRIVER=s3
# S3-compatible (MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=cms-media
# URL pública de los archivos. Con STORAGE_DRIVER=s3: CDN o MinIO
# (p.ej. http://localhost:9000/cms-media). Con STORAGE_DRIVER=fs: http://localhost:4321/media
STORAGE_PUBLIC_URL=http://localhost:9000/cms-media
# Fuerza path-style (necesario con MinIO)
STORAGE_FORCE_PATH_STYLE=true

# Límites de archivos
MAX_FILE_SIZE=52428800
MAX_BULK_FILES=5000

# Email (SMTP) — recuperación de contraseña y avisos
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="CMS EMCO SALUD <no-reply@emcosalud.com>"

# Jobs (pg-boss)
PGBOSS_SCHEMA=pgboss
WEBHOOK_DEBOUNCE_SECONDS=30

# Superadmin inicial (usado por `npm run seed` / `npm run create:superadmin`)
SEED_SUPERADMIN_EMAIL=admin@emcosalud.com
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=Administrador
