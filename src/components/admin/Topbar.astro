---
import { Menu } from 'lucide-react';
import PortalSwitcher from './PortalSwitcher.tsx';
import UserMenu from './UserMenu.tsx';
import type { PortalListItem } from '@/server/repositories/portalRepository';

interface Props {
  title: string;
  portals: PortalListItem[];
  currentPortal: string | null;
  user: { name: string; email: string; role: string };
}
const { title, portals, currentPortal, user } = Astro.props;
const portalOpts = portals.map((p) => ({
  slug: p.slug,
  name: p.name,
  shortName: p.shortName,
}));
---

<header
  class="flex h-14 shrink-0 items-center gap-3 border-b border-slate-200 bg-white px-4 lg:px-6"
>
  <button
    id="sidebar-toggle"
    class="rounded-md p-1.5 text-slate-500 hover:bg-slate-100 lg:hidden"
    aria-label="Abrir menú"
  >
    <Menu className="h-5 w-5" />
  </button>

  <h1 class="text-sm font-semibold text-slate-800">{title}</h1>

  <div class="ml-auto flex items-center gap-3">
    <PortalSwitcher client:load portals={portalOpts} current={currentPortal} />
    <UserMenu client:load name={user.name} email={user.email} role={user.role} />
  </div>
</header>

<script>
  document.getElementById('sidebar-toggle')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('cms:toggle-sidebar'));
  });
</script>
