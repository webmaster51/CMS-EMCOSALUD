---
import AuthLayout from '@/layouts/AuthLayout.astro';
import ResetPasswordForm from '@/components/auth/ResetPasswordForm.tsx';

export const prerender = false;

const token = Astro.url.searchParams.get('token');
const invalid = Astro.url.searchParams.get('error');
---

<AuthLayout title="Restablecer contraseña">
  {
    !token || invalid ? (
      <p class="text-sm text-slate-600">
        El enlace no es válido o expiró.
        <a href="/forgot-password" class="text-brand-600 hover:underline">
          Solicitar uno nuevo
        </a>
      </p>
    ) : (
      <ResetPasswordForm client:load token={token} />
    )
  }
</AuthLayout>
