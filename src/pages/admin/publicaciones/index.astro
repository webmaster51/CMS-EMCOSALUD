---
import AdminLayout from '@/layouts/AdminLayout.astro';
import BoardPublicationsTable from '@/components/publicaciones/BoardPublicationsTable.tsx';
import { requireResource } from '@/lib/auth/session';
import { listBoardPublicationsPaged } from '@/server/repositories/boardPublicationRepository';
import { listPortals } from '@/server/repositories/portalRepository';
import { getSelectedPortalSlug } from '@/lib/portal-context';
import { boardPublicationListSchema } from '@/lib/validations/boardPublication';
import type { PagedDTO } from '@/lib/dto/portal';
import type { BoardPublicationDTO } from '@/lib/dto/boardPublication';

export const prerender = false;
await requireResource(Astro, 'publicaciones');

const portalsAll = await listPortals();
const selectedSlug = getSelectedPortalSlug(Astro);
const selectedPortal = selectedSlug
  ? portalsAll.find((p) => p.slug === selectedSlug)
  : undefined;

const params = boardPublicationListSchema.parse({
  ...Object.fromEntries(Astro.url.searchParams),
  ...(selectedPortal ? { portalId: selectedPortal.id } : {}),
});
const initial: PagedDTO<BoardPublicationDTO> = await listBoardPublicationsPaged(params);
const portalOptions = portalsAll.map((p) => ({ id: p.id, name: p.name }));
---

<AdminLayout title="Publicaciones de cartelera">
  <p class="mb-4 text-sm text-slate-500">
    Avisos tipo cartelera (imagen). Una misma publicación puede mostrarse en varios portales
    con <strong>General</strong> o en <strong>Todos los portales</strong>, sin duplicarla.
  </p>
  <BoardPublicationsTable client:load initial={initial} portals={portalOptions} />
</AdminLayout>
