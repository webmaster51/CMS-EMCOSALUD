---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AuditTable from '@/components/auditoria/AuditTable.tsx';
import { requireResource } from '@/lib/auth/session';
import { auditFacets, listAuditPaged } from '@/server/repositories/auditRepository';
import { auditListSchema } from '@/lib/validations/audit';

export const prerender = false;
await requireResource(Astro, 'auditoria');

const params = auditListSchema.parse(Object.fromEntries(Astro.url.searchParams));
const [page, facets] = await Promise.all([listAuditPaged(params), auditFacets()]);
const initial = { ...page, facets };
---

<AdminLayout title="Auditoría">
  <p class="mb-4 text-sm text-slate-500">
    Registro de todas las acciones del equipo (creación, edición, publicación, cargas,
    accesos). Solo lectura. Haz clic en una fila para ver el detalle.
  </p>
  <AuditTable client:load initial={initial} />
</AdminLayout>
