---
import AdminLayout from '@/layouts/AdminLayout.astro';
import BoletinesTable from '@/components/boletines/BoletinesTable.tsx';
import { requireResource } from '@/lib/auth/session';
import { listBoletinesPaged } from '@/server/repositories/boletinRepository';
import { listPortals } from '@/server/repositories/portalRepository';
import { getSelectedPortalSlug } from '@/lib/portal-context';
import { boletinListSchema } from '@/lib/validations/boletin';
import type { PagedDTO } from '@/lib/dto/portal';
import type { BoletinDTO } from '@/lib/dto/boletin';

export const prerender = false;
await requireResource(Astro, 'boletines');

const portalsAll = await listPortals();
const selectedSlug = getSelectedPortalSlug(Astro);
const selectedPortal = selectedSlug
  ? portalsAll.find((p) => p.slug === selectedSlug)
  : undefined;

const params = boletinListSchema.parse({
  ...Object.fromEntries(Astro.url.searchParams),
  ...(selectedPortal ? { portalId: selectedPortal.id } : {}),
});
const initial: PagedDTO<BoletinDTO> = await listBoletinesPaged(params);

const portalOptions = portalsAll.map((p) => ({ id: p.id, name: p.name }));
---

<AdminLayout title="Boletines">
  <p class="mb-4 text-sm text-slate-500">
    Un único boletín puede publicarse en varios portales con la opción <strong>General</strong>
    o en <strong>Todos los portales</strong>, sin duplicarlo.
  </p>
  <BoletinesTable client:load initial={initial} portals={portalOptions} />
</AdminLayout>
